# ==========================================================================
# Este arquivo é OPCIONAL.
#
# A forma recomendada de configurar o agente é pela tela web:
#     python main.py   →   abra http://127.0.0.1:8000/config
#
# Ela grava tudo num arquivo local (.config.local.json), que fica fora do
# git e com permissão 0600. Use este .env se preferir manter as chaves em
# um arquivo de texto, ou para fixar valores que a tela não deve mudar.
#
# Os segredos (NOTION_TOKEN, API_AUTH_TOKEN) podem ficar em branco: a tela
# preenche. Preencha aqui apenas o que quiser versionar ou fixar.
# ==========================================================================

# Ambiente: "development" (padrão, local) ou "production" (Render).
# Em produção, API_AUTH_TOKEN passa a ser obrigatório.
ENVIRONMENT=development

# Servidor web. Localmente pode deixar em branco (usa os padrões abaixo).
# No Render, a variável PORT é injetada automaticamente pela plataforma
# — não precisa ser definida manualmente lá.
HOST=127.0.0.1
PORT=8000
# Origens liberadas para CORS, separadas por vírgula. Deixe em branco se a
# interface web for servida pelo mesmo domínio da API (caso padrão deste
# projeto).
CORS_ORIGINS=

# Token exigido no header "Authorization: Bearer <token>" para usar
# /api/chat, /api/reset e /api/config. Sem isso, qualquer pessoa com a URL
# pública do Render consegue ler seus e-mails, mexer na agenda e criar notas.
# Gere um valor aleatório, por exemplo: openssl rand -hex 32
# Deixe em branco para definir pela tela de configuração.
API_AUTH_TOKEN=

# Ollama
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434

# Fuso horário usado na agenda
TIMEZONE=America/Sao_Paulo

# Google (os arquivos ficam na raiz do projeto)
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# Notion
NOTION_TOKEN=
NOTION_DATABASE_ID=
# Nome da coluna de título do banco ("Name" em inglês, "Nome" em português)
NOTION_TITLE_PROP=Name

# Ferramentas habilitadas, separadas por vírgula. Vazio = todas.
# Exemplo: listar_eventos,criar_evento,listar_emails,ler_email
# Recomendado configurar pela tela, em /config.
ENABLED_TOOLS=

# Skills: instruções extras injetadas no system prompt, em JSON.
# Exemplo: [{"nome":"agenda","instrucoes":"Sempre confirmar antes de criar."}]
# Recomendado configurar pela tela, em /config.
SKILLS=

# MCP (opcional): JSON com servidores MCP externos cujas ferramentas o
# agente deve carregar, além das nativas (Google/Gmail/Notion).
# Exemplo:
# MCP_SERVERS={"meu_servidor":{"transport":"streamable_http","url":"https://exemplo.com/mcp"}}
MCP_SERVERS=

# Onde a tela de configuração grava os valores (relativo à raiz do projeto).
CONFIG_FILE=.config.local.json
